.segmented-meter 
{
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-start;
    padding: 4px;
}

.meter-segment 
{
    margin-right: -2px;
    margin-left: -2px;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0%;

    height: 100%;
    background-color:rgb(137, 212, 131);
    border-radius: 2px;
    transition: opacity 0.2s ease, width 0.2s ease;
    opacity: 1;
    border-radius: 12px;
    border-width: 4px;
    border-color: rgb(0, 0, 0);
}

.meter-segment-fill 
{
    height: 100%;
    width: 100%;
    background-color: white;
}