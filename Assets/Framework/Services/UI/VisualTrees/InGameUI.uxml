<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement name="Main" style="flex-grow: 1; border-left-width: 0; margin-left: 32px; margin-top: 32px; margin-right: 32px; margin-bottom: 0;">
        <engine:VisualElement name="MeterContainer" style="flex-grow: 1; align-self: flex-start; align-items: stretch; width: 50%; background-color: rgba(0, 0, 0, 0);">
            <SegmentedMeter segment-behaviour="Fade" value-current="55" segment-amount="10" name="HealthMeter" segment-gap="-2" segment-radius="16" segment-full-color="#83D455FF" segment-empty-color="#374133FF" segment-border="4" style="min-height: 64px; height: 64px; max-height: 64px; background-color: rgba(0, 0, 0, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); width: 65%; margin-bottom: 0; left: auto; top: auto; margin-top: 0;" />
            <SegmentedMeter segment-behaviour="Fade" value-current="100" segment-amount="50" name="AmmoMeter" segment-gap="-1" segment-border="2" segment-radius="4" segment-full-color="#AF7ACFFF" segment-empty-color="#29222EFF" segment-rotation="45" style="min-height: 32px; height: 32px; max-height: 32px; background-color: rgba(0, 0, 0, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); width: 90%; padding-top: 4px; padding-right: 4px; padding-bottom: 4px; padding-left: 4px; border-top-left-radius: 4px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; border-bottom-left-radius: 4px; left: auto; margin-left: 32px;" />
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
